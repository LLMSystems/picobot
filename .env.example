# Copy to .env and fill in. Used by `docker compose up` and local runs.

# --- Required ---
OPENAI_API_KEY=your_api_key_here
SESSION_SECRET=change-me-to-a-long-random-string   # signs the login cookie
ADMIN_USERNAMES=your_username                       # comma-separated admins (Dashboard/Alerts/MCP)

# --- Optional ---
# TAVILY_API_KEY=tvly-your_api_key_here              # enables the web-search tool
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1   # local / OpenAI-compatible server
# SESSION_COOKIE_SECURE=true                         # set when serving over HTTPS
# PICOBOT_EXEC_SANDBOX=0                              # disable the bubblewrap exec sandbox
# CORS_ALLOWED_ORIGINS=                              # not needed when backend serves the frontend (same origin)
