{
  "provider": "openai_compat",
  "model": "gpt-4o-mini",
  "subagentModel": "gpt-4o-mini",
  "maxConcurrentSubagents": 20,
  "availableModels": [
    "gpt-4.1-mini",
    "gpt-4o-mini",
    "gpt-5-nano",
    "gpt-5-mini"
  ],
  "maxTokens": 4000,
  "contextWindowTokens": 32000,
  "memoryEnabled": true,
  "memoryCompressionRatio": 0.5,
  "maxIterations": 40,
  "temperature": 0.2,
  "workspaceRootDir": "workspaces",
  "skillsDir": "custom_skills",
  "browser": {
    "chromeDebuggingPort": 9222,
    "host": "0.0.0.0"
  }
}
